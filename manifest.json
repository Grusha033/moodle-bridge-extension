{
  "manifest_version": 3,
  "name": "Moodle Agent Bridge",
  "version": "1.4.0",
  "description": "Relays Moodle quiz questions to the MongoDB-backed bridge and AI agent, and draws arrows on correct answers.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moodle Agent Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/mod/quiz/attempt.php*",
        "*://*/mod/quiz/review.php*",
        "file://*/*.html"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
